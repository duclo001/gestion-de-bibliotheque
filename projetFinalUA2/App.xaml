<Application x:Class="projetFinalUA2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Thème de base obligatoire -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml"/>

                <!-- Choix du thème : Light ou Dark + couleur d'accent -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--mes propres styles-->
            <Style TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Width" Value="300"/>
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Width" Value="300"/>
            </Style>

            <Style TargetType="DatePicker" BasedOn="{StaticResource MahApps.Styles.DatePicker}">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="50"/>
                <Setter Property="Width" Value="140"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button}">
                <Setter Property="Margin" Value="5"/>
            </Style>

            <Style TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Height" Value="500"/>
            </Style>

            <!-- Styles globaux pour les formulaires CRUD -->
            <Style x:Key="CrudFormBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="Gray"/>
            </Style>

            <Style x:Key="CrudFormTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <!-- Styles UI : barre de recherche Livres -->
            <Thickness x:Key="SearchItemMargin">0,0,8,0</Thickness>

            <Style x:Key="LivreSearchTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource MahApps.Styles.TextBox}">
                <Setter Property="Width" Value="220"/>
                <Setter Property="Margin" Value="{StaticResource SearchItemMargin}"/>
            </Style>

            <Style x:Key="LivreSearchComboStyle"
                   TargetType="ComboBox"
                   BasedOn="{StaticResource MahApps.Styles.ComboBox}">
                <Setter Property="Width" Value="200"/>
                <Setter Property="Margin" Value="{StaticResource SearchItemMargin}"/>
            </Style>

            <Style x:Key="LivreSearchDatePickerStyle"
                   TargetType="DatePicker"
                   BasedOn="{StaticResource MahApps.Styles.DatePicker}">
                <Setter Property="Width" Value="140"/>
                <Setter Property="Margin" Value="{StaticResource SearchItemMargin}"/>
            </Style>

            <Style x:Key="LivreSearchButtonPrimaryStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MahApps.Styles.Button.Square.Accent}">
                <Setter Property="Margin" Value="{StaticResource SearchItemMargin}"/>
            </Style>

            <Style x:Key="LivreSearchButtonSecondaryStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MahApps.Styles.Button.Flat}">
                <Setter Property="Margin" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

